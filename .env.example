# "offline" runs the deterministic rule extractor (no API key needed).
# Any other value is passed to LangChain's init_chat_model, for example:
#   groq:llama-3.3-70b-versatile   (pip install ".[groq]",      GROQ_API_KEY)
#   openai:gpt-4.1-mini            (pip install ".[openai]",    OPENAI_API_KEY)
#   anthropic:claude-sonnet-4-5    (pip install ".[anthropic]", ANTHROPIC_API_KEY)
#   ollama:qwen2.5:7b              (pip install ".[ollama]",    local Ollama)
INVOICEGUARD_LLM=offline
GROQ_API_KEY=

# Approval policy
INVOICEGUARD_AUTO_APPROVE_LIMIT=5000
INVOICEGUARD_RISK_THRESHOLD=30
INVOICEGUARD_PRICE_TOLERANCE_PCT=2
INVOICEGUARD_MAX_REPAIRS=2
INVOICEGUARD_BUYER_VAT_ID=DE298765432
